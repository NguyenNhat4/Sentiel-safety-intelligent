# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
# The current MVP two-command workflow uses local SQLite by default.
DATABASE_URL=sqlite:///./data/safety_events.db
# PostgreSQL remains supported when a deployment explicitly overrides DATABASE_URL, for example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ppe_safety_db
# If an explicitly configured primary database cannot be reached during startup, local SQLite
# may be used for that process. Fallback data is not automatically synchronized to PostgreSQL.
DATABASE_FALLBACK_ENABLED=true
DATABASE_FALLBACK_URL=sqlite:///./data/safety_events.db
DATABASE_CONNECT_TIMEOUT_SECONDS=5
# Reuse warm pooled connections. Enable pre-ping only if the provider frequently
# drops idle sessions; it adds a network round-trip to every checkout.
DATABASE_POOL_PRE_PING=false
DATABASE_POOL_SIZE=5
DATABASE_POOL_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=300
DATABASE_POOL_USE_LIFO=true

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Telegram safety alerts ----
# Create a bot with @BotFather. Each recipient must send /start to the bot,
# then save that private chat ID on their Sentinel account.
TELEGRAM_BOT_TOKEN=
TELEGRAM_REQUEST_TIMEOUT_SECONDS=5

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=f3p1dEOhD_z8qjjtbeCtb2t9ASMEliz-4juZfWe3ZPgCtPZp-LjWthBfeNU8d5dP
AI_LOG_DIR=.ai-log

