# Example hosted-deployment variables. Set these in Railway's Variables page;
# Docker Compose local uses its private PostgreSQL `db` service instead.
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
# APP_VERSION=
CORS_ORIGINS=http://localhost:8000
MEDIA_ASSET_DIR=/app/data/media-assets
MAX_MEDIA_ASSET_BYTES=1073741824
MEDIA_INFERENCE_MAX_FPS=2
MEDIA_STORAGE_BACKEND=s3
MEDIA_STORAGE_BUCKET=
MEDIA_STORAGE_ENDPOINT_URL=
MEDIA_STORAGE_REGION=auto
MEDIA_STORAGE_ACCESS_KEY_ID=
MEDIA_STORAGE_SECRET_ACCESS_KEY=
# Set DATABASE_URL only for a managed PostgreSQL deployment. URL-encode its password if needed.
DATABASE_URL=
DATABASE_FALLBACK_ENABLED=false
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_POOL_PRE_PING=true
DATABASE_POOL_SIZE=5
DATABASE_POOL_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=300
DATABASE_POOL_USE_LIFO=true
RUN_DB_MIGRATIONS_ON_START=false
AUDIT_RETENTION_DAYS=365
SNAPSHOT_RETENTION_DAYS=90

SNAPSHOT_STORAGE_BACKEND=s3
SNAPSHOT_STORAGE_BUCKET=p047-redacted-snapshots
SNAPSHOT_STORAGE_ENDPOINT_URL=
SNAPSHOT_STORAGE_REGION=auto
SNAPSHOT_STORAGE_ACCESS_KEY_ID=
SNAPSHOT_STORAGE_SECRET_ACCESS_KEY=


PPE_MODEL_PATH=models/yolo11n_safety_kd_best.pt
PERSON_DETECTION_CONFIDENCE=0.6
PPE_DETECTION_CONFIDENCE=0.2
YOLO_INFERENCE_IMAGE_SIZE=960
PPE_TEMPORAL_FRAMES=10
# Use remote after the separately deployed vision worker passes its /ping smoke check.
VISION_PROVIDER=local
VISION_REMOTE_URL=
VISION_REMOTE_API_KEY=
VISION_REMOTE_TIMEOUT_SECONDS=5
# Deploy the dual-contract worker and migration before switching this to safety_vision_v2.
VISION_REMOTE_CONTRACT_VERSION=safety_vision_v1
VISION_TRACKING_STATE_TTL_SECONDS=86400
VISION_TRACKING_STATE_MAX_BYTES=524288
FACE_DETECTOR_MODEL_PATH=models/face_detection_yunet_2023mar.onnx
FACE_DETECTOR_SCORE_THRESHOLD=0.6
FACE_REDACTION_MARGIN_RATIO=0.2
VIOLATION_FRAME=4
OPERATIONAL_METRICS_LOG_PATH=data/operational-metrics.jsonl

LOG_LEVEL=INFO
# Optional: leave blank to use the offline safety recommendation.
OPENAI_API_KEY=
