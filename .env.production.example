# Copy to .env.production for Docker Compose local MVP deployment.
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:8000
# Use a separate untracked environment file for hosted PostgreSQL credentials.
DATABASE_URL=sqlite:///./data/safety_events.db
DATABASE_FALLBACK_ENABLED=false
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_POOL_PRE_PING=false
DATABASE_POOL_SIZE=5
DATABASE_POOL_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=300
DATABASE_POOL_USE_LIFO=true
PERSON_MODEL_PATH=models/yolo11n.pt
PPE_MODEL_PATH=models/ppe_yolov8n.pt
APP_ENV=production
DATABASE_URL=<Render internal Postgres URL>
DATABASE_FALLBACK_ENABLED=false
SNAPSHOT_STORAGE_BACKEND=s3
SNAPSHOT_STORAGE_BUCKET=<bucket>
SNAPSHOT_STORAGE_ENDPOINT_URL=<S3/R2 endpoint>
SNAPSHOT_STORAGE_REGION=auto
SNAPSHOT_STORAGE_ACCESS_KEY_ID=<key>
SNAPSHOT_STORAGE_SECRET_ACCESS_KEY=<secret>
CORS_ORIGINS=https://<your-render-domain>
OPERATIONAL_METRICS_LOG_PATH=data/operational-metrics.jsonl
SNAPSHOT_DIR=data/snapshots
LOG_LEVEL=INFO
# Optional: leave blank to use the offline safety recommendation.
OPENAI_API_KEY=
