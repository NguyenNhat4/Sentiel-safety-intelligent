# Copy to .env.development for local development.
# Never commit .env.development or production credentials.

# ---- Database ----
# The two-command developer workflow uses local SQLite by default.
DATABASE_URL=sqlite:///./data/safety_events.db
DATABASE_FALLBACK_ENABLED=true
DATABASE_FALLBACK_URL=sqlite:///./data/safety_events.db
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_POOL_PRE_PING=false
DATABASE_POOL_SIZE=5
DATABASE_POOL_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=300
DATABASE_POOL_USE_LIFO=true

# ---- Application ----
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO

# ---- Local storage and models ----
CHROMA_PERSIST_DIR=./data/chroma
OPERATIONAL_METRICS_LOG_PATH=data/operational-metrics.jsonl
SNAPSHOT_DIR=data/snapshots
PERSON_MODEL_PATH=models/yolo11n.pt
PPE_MODEL_PATH=models/ppe_yolov8n.pt

# Optional: leave blank to use the offline safety recommendation.
OPENAI_API_KEY=
